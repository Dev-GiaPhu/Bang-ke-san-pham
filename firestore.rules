rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function workspace(wid) { return /databases/$(database)/documents/workspaces/$(wid); }
    function member(wid, uid) { return /databases/$(database)/documents/workspaces/$(wid)/members/$(uid); }
    function invite(wid, email) { return /databases/$(database)/documents/workspaces/$(wid)/invites/$(email); }
    function revoked(wid, email) { return /databases/$(database)/documents/workspaces/$(wid)/revoked/$(email); }
    function share(wid, sid) { return /databases/$(database)/documents/workspaces/$(wid)/shares/$(sid); }
    function isMember(wid) { return signedIn() && exists(member(wid, request.auth.uid)); }
    function isOwner(wid) { return isMember(wid) && get(member(wid, request.auth.uid)).data.role == 'owner'; }
    function isEditor(wid) { return isMember(wid) && get(member(wid, request.auth.uid)).data.role in ['owner','editor']; }
    function canInvite(wid) { return isOwner(wid) || (isMember(wid) && get(member(wid, request.auth.uid)).data.canInvite == true); }
    function selfInvited(wid) {
      return signedIn() &&
        exists(invite(wid, request.auth.token.email)) &&
        get(invite(wid, request.auth.token.email)).data.email == request.auth.token.email &&
        !exists(revoked(wid, request.auth.token.email));
    }

    match /workspaces/{wid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isOwner(wid);

      match /members/{uid} {
        allow read: if isMember(wid) || (signedIn() && uid == request.auth.uid);
        allow create: if (isOwner(wid)) ||
          (signedIn() && uid == request.auth.uid &&
            get(workspace(wid)).data.ownerUid == request.auth.uid &&
            request.resource.data.role == 'owner') ||
          (selfInvited(wid) && uid == request.auth.uid &&
            request.resource.data.email == request.auth.token.email &&
            request.resource.data.role == get(invite(wid, request.auth.token.email)).data.role &&
            request.resource.data.canInvite == get(invite(wid, request.auth.token.email)).data.canInvite &&
            request.resource.data.driveAccess == get(invite(wid, request.auth.token.email)).data.driveAccess);
        allow update, delete: if isOwner(wid);
      }

      match /invites/{email} {
        allow read: if isOwner(wid) || (signedIn() && request.auth.token.email == email);
        allow create, update, delete: if canInvite(wid);
      }

      match /revoked/{email} {
        allow read, write, delete: if isOwner(wid);
      }

      match /products/{pid} {
        allow read: if isMember(wid);
        allow create, update, delete: if isEditor(wid);
      }

      match /shares/{sid} {
        allow read: if resource.data.active == true || isMember(wid);
        allow create, update, delete: if isOwner(wid);

        match /products/{pid} {
          allow read: if get(share(wid, sid)).data.active == true || isMember(wid);
          allow create, update, delete: if isEditor(wid);
        }
      }
    }

    match /mail/{mid} {
      allow read, write: if false;
    }
  }
}
